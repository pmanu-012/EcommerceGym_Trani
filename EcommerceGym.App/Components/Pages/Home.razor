@page "/"
@inject ProductoService ProductoService
@inject AuthService Auth

<h3>Prueba de conexión</h3>

<AuthorizeView>
     <Authorized>
         <p>
             Hola, @context.User.Identity?.Name (@(context.User.IsInRole("Administrador") ? "Administrador" : "Cliente"))
             <button class="btn btn-sm btn-outline-dark ms-2" @onclick="Auth.LogoutAsync">Cerrar sesión</button>
         </p>
     </Authorized>
     <NotAuthorized>
         <a class="btn btn-sm btn-dark" href="login">Iniciar sesión</a>
     </NotAuthorized>
</AuthorizeView>
 <p><a href="prueba-admin">Ir a la zona de administradores</a></p>

@if (error is not null)
{
    <p style="color:red">@error</p>
}
else if (productos is null)
{
    <p>Cargando...</p>
}
else
{
    <p>Productos recibidos: @productos.Count</p>
    <ul>
        @foreach (var p in productos)
        {
            <li>@p.Nombre — $@p.Precio</li>
        }
    </ul>
}

@code {
    private List<ProductoDto>? productos;
    private string? error;

    //es un evento del ciclo de vida de los componentes que se ejecuta una sola vez cuando 
    //el componente está listo para iniciarse y ya ha recibido sus parámetros iniciales
    protected override async Task OnInitializedAsync()
    {
        try
        {
            productos = await ProductoService.GetProductosAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}