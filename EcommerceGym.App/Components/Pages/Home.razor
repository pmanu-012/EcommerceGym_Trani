@page "/"
@inject ProductoService Productos

<section class="hero">
    <h1>Equipamiento para tu gimnasio</h1>
    <p>Todo lo que necesitás para entrenar, en un solo lugar.</p>
    <a class="btn-accent" href="ofertas">Ver ofertas</a>
</section>

<SeccionResenas Titulo="Lo que dicen nuestros clientes"
                TextoVacio="Todavía no hay reseñas. ¡Sé el primero en dejar la tuya!"
                TextoBoton="Añadir una reseña" />

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (destacados is null || ofertas is null)
{
    <p class="text-secondary">Cargando...</p>
}
else
{
    @if (ofertas.Count > 0)
    {
        <h2 class="titulo-seccion">Ofertas</h2>
        <div class="grid-productos">
            @foreach (var p in ofertas)
            {
                <ProductoCard Producto="p" />
            }
        </div>
    }

    <h2 class="titulo-seccion">Productos destacados</h2>
    <div class="grid-productos">
        @foreach (var p in destacados)
        {
            <ProductoCard Producto="p" />
        }
    </div>
}

@code {
    private List<ProductoDto>? destacados;
    private List<ProductoDto>? ofertas;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ofertas = (await Productos.GetProductosAsync(soloOfertas: true)).Take(4).ToList();
            destacados = (await Productos.GetProductosAsync(orden: "recientes")).Take(6).ToList();
        }
        catch (Exception)
        {
            error = "No se pudieron cargar los productos. Verificá tu conexión e intentá de nuevo.";
        }
    }
}