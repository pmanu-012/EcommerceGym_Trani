@page "/perfil"
@attribute [Authorize]
@inject AuthService Auth
@inject NavigationManager Nav

<div class="perfil-cabecera">
    <div class="avatar"><Icono Nombre="person" Tamano="56" /></div>
    <h1>@Auth.Sesion?.Nombre @Auth.Sesion?.Apellido</h1>
    <p class="email">@Auth.Sesion?.Email</p>
    <span class="badge-rol">@Auth.Sesion?.Rol</span>
</div>

@if (!Auth.EsAdmin)
{
    <a class="fila-menu" href="mis-pedidos">
        <Icono Nombre="pedidos" />
        <span>Mis pedidos</span>
        <Icono Nombre="chevron" />
    </a>
}

@if (Auth.EsAdmin)
{
    <a class="fila-menu" href="admin">
        <Icono Nombre="stats" />
        <span>Panel de administración</span>
        <Icono Nombre="chevron" />
    </a>
}

<button class="btn-bloque btn-peligro" @onclick="Salir">Cerrar sesión</button>

@code {
    private async Task Salir()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/");
    }
}