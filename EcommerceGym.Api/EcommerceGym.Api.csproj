    <UserSecretsId>6406ae67-5520-4e23-8bbd-1bd5de6bb037</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
